{
	"luci-app-aigate": {
		"description": "PeDItXOS-AiGate AI gateway control",
		"read": {
			"ubus": {
				"rc": [
					"list"
				]
			},
			"uci": [
				"aigate"
			],
			"file": {
				"/usr/lib/aigate/VERSION": [
					"read"
				],
				"/tmp/aigate-update.log": [
					"read"
				],
				"/usr/share/aigate/providers.json": [
					"read"
				],
				"/root/.aigate/requests.log": [
					"read"
				],
				"/tmp/aigate-quota": [
					"list"
				]
			}
		},
		"write": {
			"ubus": {
				"rc": [
					"init"
				]
			},
			"uci": [
				"aigate"
			],
			"file": {
				"/usr/sbin/aigate-validate": [
					"exec"
				],
				"/usr/sbin/aigate-fetch-models": [
					"exec"
				]
			}
		}
	}
}