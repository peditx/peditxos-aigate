#!/bin/sh /etc/rc.common
# PeDItXOS-AiGate — dedicated uhttpd instance hosting the native Lua gateway.
# -x '/'  : every file under the docroot is CGI (route stubs are shebang Lua).
# -t/-T   : raise uhttpd's defaults (60s/30s) — they would kill SSE streams
#           and any thinking pause longer than 30s.

USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled port

	config_load aigate
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get port main port 20128

	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f \
		-p "0.0.0.0:$port" \
		-h /usr/lib/aigate/www \
		-x / -I index.lua \
		-n 10 -N 100 -D \
		-t 86400 -T 86400
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}
